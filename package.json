{
  "name": "aurora-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm --filter aurora-studio build && pnpm --filter aurora-site build",
    "typecheck": "vue-tsc -b && pnpm --filter \"./apps/**\" typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:all": "vitest run --project unit --project browser",
    "coverage": "vitest run --project unit --coverage",
    "changeset": "changeset",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:all --coverage && pnpm build && pnpm test:apps && pnpm size",
    "size": "node scripts/size.ts",
    "test:apps": "vitest run --project apps && vitest run --config apps/studio/vitest.config.ts && vitest run --config apps/site/vitest.config.ts",
    "badges:generate": "node scripts/generate-badges.ts",
    "consumers": "node scripts/consumers.ts",
    "release": "pnpm -r --filter \"@goatsoft/*\" build && node scripts/publish.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.19.2",
    "@valibot/to-json-schema": "^1.8.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.1",
    "@webgpu/types": "^0.1.74",
    "eslint": "^10.12.0",
    "eslint-plugin-better-tailwindcss": "^4.9.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-vue": "^10.11.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "playwright": "1.56.1",
    "publint": "^0.3.25",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "imports": {
    "#badge-assets": "./assets/brand/badges/generate.ts"
  }
}
