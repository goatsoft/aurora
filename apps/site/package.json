{
  "name": "aurora-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "vite build --configLoader runner && vite build --configLoader runner --ssr src/entry-server.ts --outDir dist-server && node prerender.ts && STUDIO_BASE=/studio/ pnpm --filter aurora-studio exec vite build --configLoader runner --outDir ../site/dist/studio --emptyOutDir",
    "preview": "vite preview --configLoader runner",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@goatsoft/aurora": "workspace:^",
    "@goatsoft/aurora-editor-ui": "workspace:^",
    "@goatsoft/aurora-format": "workspace:^",
    "@goatsoft/aurora-vue": "workspace:^",
    "@goatsoft/color": "workspace:^",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "minisearch": "^7.2.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@goatsoft/aurora-unplugin": "workspace:^",
    "@goatsoft/gruff": "workspace:^",
    "@iconify-json/hugeicons": "^1.2.35",
    "@iconify-json/simple-icons": "^1.2.100",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "tailwindcss": "^4.3.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-icons": "^24.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
