{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": { "@/*": ["./src/*"], "~/*": ["../../*"] },
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["node", "vite/client", "@goatsoft/aurora-unplugin/client", "unplugin-icons/types/vue"],
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable", "DOM.AsyncIterable", "WebWorker.ImportScripts"]
  },
  "include": ["types", "src", "src/**/*.vue", "test", "vite.config.ts", "vitest.config.ts"]
}
