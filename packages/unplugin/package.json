{
  "name": "@goatsoft/aurora-unplugin",
  "version": "0.1.1",
  "description": "Import .aurora files in Vite, Rollup, Rolldown, esbuild, webpack and Rspack: validated at build time, typed, hot-reloaded.",
  "keywords": [
    "aurora",
    "unplugin",
    "vite-plugin",
    "rollup-plugin",
    "webpack-plugin",
    "esbuild-plugin",
    "rspack-plugin"
  ],
  "license": "MIT",
  "homepage": "https://aurora.goatsoft.io/docs/guide/getting-started",
  "bugs": {
    "url": "https://github.com/goatsoft/aurora/issues"
  },
  "type": "module",
  "sideEffects": [
    "./src/cli.ts",
    "./dist/cli.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goatsoft/aurora.git",
    "directory": "packages/unplugin"
  },
  "files": [
    "dist",
    "client.d.ts"
  ],
  "exports": {
    ".": {
      "@goatsoft/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "@goatsoft/source": "./src/vite.ts",
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./rollup": {
      "@goatsoft/source": "./src/rollup.ts",
      "types": "./dist/rollup.d.ts",
      "import": "./dist/rollup.js"
    },
    "./rolldown": {
      "@goatsoft/source": "./src/rolldown.ts",
      "types": "./dist/rolldown.d.ts",
      "import": "./dist/rolldown.js"
    },
    "./esbuild": {
      "@goatsoft/source": "./src/esbuild.ts",
      "types": "./dist/esbuild.d.ts",
      "import": "./dist/esbuild.js"
    },
    "./webpack": {
      "@goatsoft/source": "./src/webpack.ts",
      "types": "./dist/webpack.d.ts",
      "import": "./dist/webpack.js"
    },
    "./rspack": {
      "@goatsoft/source": "./src/rspack.ts",
      "types": "./dist/rspack.d.ts",
      "import": "./dist/rspack.js"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./cli": {
      "@goatsoft/source": "./src/cli.ts",
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "vite build --config ../../vite.library.ts && tsc -p tsconfig.build.json && node ../../scripts/dts-extensions.ts",
    "prepack": "node ../../scripts/prepack.ts"
  },
  "dependencies": {
    "@goatsoft/aurora": "workspace:^",
    "@goatsoft/aurora-format": "workspace:^",
    "unplugin": "^3.4.0"
  },
  "bin": {
    "aurora": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
