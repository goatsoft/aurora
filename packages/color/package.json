{
  "name": "@goatsoft/color",
  "version": "0.3.0",
  "description": "OKLab and OKLCH colour maths: sRGB and Display P3, CSS Color 4 gamut mapping, ΔE-OK and CSS colour parsing. Zero dependencies.",
  "keywords": [
    "color",
    "colour",
    "oklab",
    "oklch",
    "display-p3",
    "gamut-mapping",
    "css-color"
  ],
  "license": "MIT",
  "homepage": "https://aurora.goatsoft.io/docs",
  "bugs": {
    "url": "https://github.com/goatsoft/aurora/issues"
  },
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goatsoft/aurora.git",
    "directory": "packages/color"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@goatsoft/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build --config ../../vite.library.ts && tsc -p tsconfig.build.json && node ../../scripts/dts-extensions.ts",
    "prepack": "node ../../scripts/prepack.ts",
    "postpack": "node ../../scripts/postpack.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
