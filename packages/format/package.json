{
  "name": "@goatsoft/aurora-format",
  "version": "0.0.0",
  "description": "The .aurora file format: schema, validation and migrations.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goatsoft/aurora.git",
    "directory": "packages/format"
  },
  "files": [
    "dist",
    "schema"
  ],
  "exports": {
    ".": {
      "@goatsoft/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/v1.json": "./schema/v1.json"
  },
  "scripts": {
    "build": "vite build --config ../../vite.library.ts && tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@goatsoft/color": "workspace:^",
    "valibot": "^1.5.0"
  }
}
