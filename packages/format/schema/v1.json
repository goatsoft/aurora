{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aurora.goatsoft.io/schema/v1.json",
  "title": "Aurora background",
  "description": "Animated @goatsoft/aurora background; data only.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema URL for autocomplete."
    },
    "format": {
      "const": "aurora",
      "description": "Always \"aurora\"."
    },
    "version": {
      "const": 1,
      "description": "Version; old files migrate on load."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Studio/gallery name."
    },
    "canvas": {
      "type": "object",
      "properties": {
        "fade": {
          "enum": [
            "none",
            "x",
            "y"
          ],
          "type": "string",
          "description": "Edge fade: y = top/bottom; x = left/right.",
          "default": "none"
        },
        "fixed": {
          "type": "boolean",
          "description": "Pin to the viewport.",
          "default": false
        },
        "parallax": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Scroll parallax: 0 moves, 1 stays fixed.",
          "default": 0
        }
      },
      "required": [],
      "additionalProperties": false,
      "default": {}
    },
    "motion": {
      "type": "object",
      "properties": {
        "speed": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Time multiplier; 0 freezes.",
          "default": 1
        },
        "reduced": {
          "enum": [
            "still",
            "slow",
            "css"
          ],
          "type": "string",
          "description": "Reduced motion: still renders once, slow uses 10% speed, css uses the fallback.",
          "default": "still"
        }
      },
      "required": [],
      "additionalProperties": false,
      "default": {}
    },
    "modifiers": {
      "type": "object",
      "properties": {
        "signal": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Overall distortion strength. Zero leaves the scene unchanged.",
              "default": 0.35
            },
            "shake": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Horizontal judder during a distortion burst.",
              "default": 0.25
            },
            "tearSize": {
              "type": "number",
              "minimum": 0.02,
              "maximum": 0.5,
              "description": "Height of the bands that stretch and slip sideways, relative to the scene's height.",
              "default": 0.15
            },
            "separation": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Separate colour channels around torn edges. Visible separation samples the scene three times; quiet frames use one sample.",
              "default": 0.2
            },
            "tracking": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Brief vertical tracking slips during a distortion burst.",
              "default": 0.15
            },
            "frequency": {
              "type": "number",
              "minimum": 0,
              "maximum": 2,
              "description": "Burst cycles per second. Zero freezes the distortion while other layers can keep moving.",
              "default": 0.5
            },
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "Choose a different distortion pattern.",
              "default": 0
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "pixelate": {
          "type": "object",
          "properties": {
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64,
              "description": "Block size in canvas pixels. One leaves the scene unchanged; the CSS size depends on the rendering pixel ratio.",
              "default": 8
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "vignette": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Edge darkness. Zero leaves the scene unchanged.",
              "default": 0.45
            },
            "radius": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Size of the clear centre, relative to the scene's shorter side.",
              "default": 0.45
            },
            "softness": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 1,
              "description": "Width of the soft transition to the dark edges, relative to the shorter scene side.",
              "default": 0.45
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "follow",
              "impulse",
              "grab"
            ],
            "type": "string"
          },
          "activation": {
            "enum": [
              "hover",
              "focus",
              "both"
            ],
            "type": "string",
            "default": "both"
          },
          "strength": {
            "type": "number",
            "minimum": 0,
            "maximum": 2,
            "description": "Response strength.",
            "default": 1
          },
          "smoothing": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Follow easing; 0 responds immediately.",
            "default": 0.65
          },
          "decay": {
            "type": "number",
            "minimum": 0.05,
            "maximum": 5,
            "description": "Seconds for an impulse or return to settle.",
            "default": 1
          },
          "damping": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Grab spring damping; higher settles faster.",
            "default": 0.75
          },
          "bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "layer": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 15
                },
                "parameter": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "description": "Generator control, opacity, offsetX, offsetY, time, or signal.control."
                },
                "input": {
                  "enum": [
                    "x",
                    "y",
                    "strength",
                    "travel"
                  ],
                  "type": "string"
                },
                "amount": {
                  "type": "number",
                  "minimum": -4,
                  "maximum": 4,
                  "description": "Add this much to the authored control at full input; negative values repel.",
                  "default": 1
                },
                "slot": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3,
                  "description": "Impulse slot, from newest (0) to oldest (3).",
                  "default": 0
                }
              },
              "required": [
                "parameter",
                "input"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 64
          }
        },
        "required": [
          "type",
          "bindings"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 8
    },
    "palette": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Hex, OKLab/OKLCH or sRGB/P3; prefer OKLCH.",
        "examples": [
          "oklch(0.68 0.16 245)",
          "oklch(0.56 0.22 285 / 0.8)",
          "#4f8cff"
        ],
        "pattern": "^\\s*(#|oklch\\(|oklab\\(|color\\()"
      },
      "minItems": 1,
      "maxItems": 16,
      "description": "Colours referenced by layers, by index."
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[a-z][a-z\\d]*(?:-[a-z\\d]+)*$",
            "description": "Generator id, e.g. aurora-fbm."
          },
          "blend": {
            "enum": [
              "normal",
              "screen",
              "add",
              "multiply",
              "overlay"
            ],
            "type": "string",
            "description": "Blend onto the layers below.",
            "default": "normal"
          },
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Layer opacity.",
            "default": 1
          },
          "params": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "string"
                }
              ]
            },
            "description": "Generator parameter names, ranges and defaults.",
            "default": {}
          },
          "colors": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Palette indices, in generator order.",
            "default": []
          },
          "mix": {
            "enum": [
              "oklab",
              "srgb"
            ],
            "type": "string",
            "description": "oklab mixing; srgb preserves classic parity.",
            "default": "oklab"
          },
          "mask": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "linear"
                  },
                  "angle": {
                    "type": "number",
                    "description": "CSS angle in degrees (180 = downward).",
                    "default": 180
                  },
                  "start": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Fade start (opaque before).",
                    "default": 0
                  },
                  "end": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Fade end (transparent after).",
                    "default": 1
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "radial"
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Centre X as a width fraction.",
                    "default": 0.5
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Centre Y as a height fraction.",
                    "default": 0.5
                  },
                  "start": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Fade start radius, relative to the half-diagonal.",
                    "default": 0
                  },
                  "end": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Fade end radius.",
                    "default": 1
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              }
            ],
            "description": "Linear or radial layer fade."
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 16,
      "description": "Layer stack, bottom first."
    },
    "fallback": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "auto"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "css"
            },
            "layers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^;{}<>@\\\\]*$",
                "description": "CSS image, e.g. an OKLab gradient."
              },
              "minItems": 1
            }
          },
          "required": [
            "mode",
            "layers"
          ],
          "additionalProperties": false
        }
      ],
      "description": "CSS fallback: auto from layers, css from gradients.",
      "default": {
        "mode": "auto"
      }
    }
  },
  "required": [
    "format",
    "version",
    "name",
    "palette",
    "layers"
  ],
  "additionalProperties": false
}
