{
  "name": "@goatsoft/aurora-vue",
  "version": "0.0.0",
  "description": "Vue 3 bindings for Aurora: <AuroraBackground>, useAurora() and <AuroraScene>, with SSR fallback.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goatsoft/aurora.git",
    "directory": "packages/vue"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@goatsoft/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build --config ../../vite.library.ts && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@goatsoft/aurora": "workspace:^"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@goatsoft/aurora-format": "workspace:^",
    "vue": "^3.5.43"
  }
}
