{
  "name": "@goatsoft/gruff",
  "version": "0.0.0",
  "description": "The rough and ready static site generator: Markdown pages as Vue components, prerendered, with docs components for Tailwind sites.",
  "keywords": [
    "vite",
    "vue",
    "markdown",
    "docs",
    "static-site-generator",
    "prerender"
  ],
  "license": "MIT",
  "homepage": "https://github.com/goatsoft/aurora/tree/develop/packages/gruff#readme",
  "bugs": {
    "url": "https://github.com/goatsoft/aurora/issues"
  },
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goatsoft/aurora.git",
    "directory": "packages/gruff"
  },
  "files": [
    "dist",
    "client.d.ts"
  ],
  "exports": {
    ".": {
      "@goatsoft/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vue": {
      "@goatsoft/source": "./src/vue.ts",
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "scripts": {
    "build": "vite build --config ../../vite.library.ts && vue-tsc -p tsconfig.build.json && node ../../scripts/dts-extensions.ts",
    "prepack": "node ../../scripts/prepack.ts",
    "postpack": "node ../../scripts/postpack.ts"
  },
  "dependencies": {
    "@shikijs/transformers": "^4.5.0",
    "gray-matter": "^4.0.3",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-container": "^4.0.0",
    "minisearch": "^7.2.0",
    "shiki": "^4.5.0",
    "subset-font": "^2.9.0",
    "unplugin-vue-markdown": "^32.1.1"
  },
  "peerDependencies": {
    "reka-ui": "^2.11.0",
    "vite": "^8.0.0",
    "vue": "^3.5.0",
    "vue-router": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "reka-ui": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/markdown-it-container": "^4.0.1",
    "markdown-it": "^15.0.2",
    "reka-ui": "^2.11.0",
    "vite": "^8.3.4",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
