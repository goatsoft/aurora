{
  "name": "@goatsoft/gruff",
  "version": "0.0.0",
  "description": "Our rustic-and-ready static site generator: Markdown pages as Vue components, prerendered.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@goatsoft/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build --config ../../vite.library.ts && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@shikijs/transformers": "^4.5.0",
    "gray-matter": "^4.0.3",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-container": "^4.0.0",
    "minisearch": "^7.2.0",
    "shiki": "^4.5.0",
    "subset-font": "^2.9.0",
    "unplugin-vue-markdown": "^32.1.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/markdown-it-container": "^4.0.1",
    "markdown-it": "^15.0.2",
    "vite": "^8.3.4"
  }
}
