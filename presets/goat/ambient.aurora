{
  "$schema": "https://aurora.goatsoft.io/schema/v1.json",
  "format": "aurora",
  "version": 1,
  "name": "GOAT ambient page background",
  "canvas": {
    "fixed": true,
    "parallax": 0.22
  },
  "palette": [
    "color(srgb 0.23 0.63 1)",
    "color(srgb 0.48 0.36 1)",
    "color(srgb 0.71 0.29 1)"
  ],
  "layers": [
    {
      "type": "aurora-fbm",
      "blend": "normal",
      "params": {
        "intensity": 0.18,
        "scale": 1.0,
        "speed": 0.04,
        "seed": 0,
        "stretch": 0.55
      },
      "colors": [
        0,
        1,
        2
      ],
      "mix": "srgb"
    }
  ]
}
