{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023"
    ],
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "outDir": "node_modules/.cache/tsc/node",
    "noEmit": false,
    "emitDeclarationOnly": true
  },
  "include": [
    "*.config.ts",
    "*.ts",
    "scripts/*.ts",
    "assets/brand/badges/*.ts"
  ]
}
